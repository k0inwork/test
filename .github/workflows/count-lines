
name: Count Lines
on: workflow_dispatch
jobs:
  count:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Count lines per file and total
        run: |
          echo "=== LINE COUNT PER FILE ==="
          find . -type f -not -path './.git/*' -exec wc -l {} + 2>/dev/null || true
          echo "=== GRAND TOTAL ==="
          find . -type f -not -path './.git/*' -exec cat {} + 2>/dev/null | wc -l
      - name: Generate structured summary
        run: |
          mkdir -p results
          {
            echo "# Line Count Summary for k0inwork/test"
            echo ""
            echo "## Per-File Breakdown"
            echo ""
            echo "| File | Lines |"
            echo "|------|-------|"
            find . -type f -not -path './.git/*' -print0 | while IFS= read -r -d '' f; do
              lines=$(wc -l < "$f" 2>/dev/null || echo 0)
              echo "| \${f} | \${lines} |"
            done
            echo ""
            total=$(find . -type f -not -path './.git/*' -exec cat {} + 2>/dev/null | wc -l)
            echo "**Grand Total: \${total} lines**"
          } > results/line-count.md
          {
            echo "{"
            echo "  \"repository\": \"k0inwork/test\","
            echo "  \"files\": ["
            first=true
            find . -type f -not -path './.git/*' -print0 | while IFS= read -r -d '' f; do
              lines=$(wc -l < "$f" 2>/dev/null || echo 0)
              if [ "$first" = true ]; then first=false; else echo ","; fi
              echo "    {\"file\": \"$f\", \"lines\": $lines}"
            done
            echo ""
            echo "  ],"
            total=$(find . -type f -not -path './.git/*' -exec cat {} + 2>/dev/null | wc -l)
            echo "  \"grand_total\": $total"
            echo "}"
          } > results/line-count.json
      - uses: actions/upload-artifact@v4
        with:
          name: line-count-results
          path: results/
