type Product {
  id: ID!
  name: String!
  description: String
  address: String
  state: String
  long: String
  lat: String
  geo: String
  operate: Boolean!
  glpiUUID: String
  sequentialNumber: Int!
  pouType: String!
  region: String!
  problems: [ZProblem!]!
  status: Int!
}

type ZProblem {
  id: ID!
  name: String!
  severity: Int!
  time: String!
}

type Query {
  products: [Product!]!
  product(id: ID!): Product
}

type Mutation {
  syncProducts: String!
}
